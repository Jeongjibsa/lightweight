{
  "name": "lightweight-app",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "format": "prettier --write src tests scripts vite.config.ts vitest.config.ts playwright.config.ts index.html wrangler.jsonc",
    "format:check": "prettier --check src tests scripts vite.config.ts vitest.config.ts playwright.config.ts index.html wrangler.jsonc",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:ui": "vitest run --project ui",
    "check": "npm run lint && npm run test && npm run build && npm run typecheck:e2e",
    "cloud:probe": "node --env-file=.env scripts/supabase-probe.mjs",
    "cloud:verify": "node --env-file=.env scripts/verify-cloud.mjs",
    "cloud:allow-user": "node --env-file=.env scripts/allow-cloud-user.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:probe": "node scripts/probe-e2e-artifacts.mjs",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "pages:check": "node scripts/check-pages-artifact.mjs dist",
    "pages:deploy": "npm run build && npm run pages:check && wrangler pages deploy dist --project-name lightweight-training --branch main"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@mantine/core": "9.6.3",
    "@mantine/hooks": "9.6.3",
    "@supabase/supabase-js": "2.117.2",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "lucide-react": "1.51.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "27.4.0",
    "oxlint": "1.86.0",
    "pg": "8.23.1",
    "prettier": "3.9.9",
    "supabase": "2.119.0",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  }
}
